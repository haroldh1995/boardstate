# Copy this file to `android-app/keystore.properties` and replace every placeholder.
# The file and keystore are ignored by Git. If credentials are absent, release output
# is test-signed for installation validation and is not suitable for Play upload.

storeFile=keystore/boardstate-upload.jks
storePassword=REPLACE_WITH_PRIVATE_STORE_PASSWORD
keyAlias=REPLACE_WITH_PRIVATE_KEY_ALIAS
keyPassword=REPLACE_WITH_PRIVATE_KEY_PASSWORD
